#!/bin/sh
# FS25 pre-commit-Hook. Wird ueber `git config core.hooksPath .githooks`
# aktiviert (einmalig pro Repo, siehe Source\Checks\Setup-Hooks.ps1).
#
# Schritt 1 (Lua-Lint + Format): prueft/formatiert alle staged *.lua-Dateien
# mit selene + StyLua ueber das zentrale Skript in
# C:\FS25\main\Source\Checks\lua\Invoke-LuaCheck.ps1. Weitere Schritte
# (XML-Validierung, Asset-Pfad-Check, l10n-Check) haengen sich unten an,
# sobald sie existieren - nicht diesen Kommentar-Block loeschen, sondern
# ergaenzen.

repo_root=$(git rev-parse --show-toplevel)
mod_name=$(basename "$repo_root")
win_root=$(printf '%s' "$repo_root" | sed -E 's#^/([a-zA-Z])/#\1:/#')

staged_lua=$(git diff --cached --name-only --diff-filter=ACM -- '*.lua')

if [ -n "$staged_lua" ]; then
    list_file="$repo_root/.git/pre-commit-lua-files.txt"
    : > "$list_file"
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        printf '%s/%s\n' "$win_root" "$f" >> "$list_file"
    done <<EOF
$staged_lua
EOF
    win_list_file=$(printf '%s' "$list_file" | sed -E 's#^/([a-zA-Z])/#\1:/#')

    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "C:/FS25/main/Source/Checks/lua/Invoke-LuaCheck.ps1" -Mod "$mod_name" -Fix -FileListPath "$win_list_file"
    lua_status=$?

    rm -f "$list_file"

    if [ $lua_status -ne 0 ]; then
        echo ""
        echo "pre-commit: Lua-Check fehlgeschlagen (siehe Ausgabe oben). Commit abgebrochen."
        exit 1
    fi

    # StyLua kann Dateien umgeschrieben haben -> erneut stagen.
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        git add -- "$f"
    done <<EOF
$staged_lua
EOF

    # Schritt 1b (lua-language-server): prueft das gesamte Mod-Arbeitsverzeichnis
    # auf erfundene/unbekannte Methoden und Globals (undefined-field wird nur
    # als Hinweis ausgegeben, siehe Invoke-LuaLsCheck.ps1). Laeuft nur, wenn
    # staged Lua-Dateien vorliegen, prueft dabei aber immer den ganzen
    # Workspace (lua-language-server braucht ein Verzeichnis, keine Dateiliste).
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "C:/FS25/main/Source/Checks/lua-ls/Invoke-LuaLsCheck.ps1" -Mod "$mod_name" -WorkspacePath "$win_root"
    lua_ls_status=$?

    if [ $lua_ls_status -ne 0 ]; then
        echo ""
        echo "pre-commit: lua-language-server-Check fehlgeschlagen (siehe Ausgabe oben). Commit abgebrochen."
        exit 1
    fi
fi

# Schritt 2 (XML-Validierung): prueft staged *.xml-Dateien gegen die
# FS25-Basisspiel-XSDs (modDesc.xml blockierend, alles andere nur als
# Hinweis, siehe Invoke-XmlCheck.ps1) bzw. auf reine Wohlgeformtheit, wo kein
# Basisspiel-Schema existiert.
staged_xml=$(git diff --cached --name-only --diff-filter=ACM -- '*.xml')

if [ -n "$staged_xml" ]; then
    xml_list_file="$repo_root/.git/pre-commit-xml-files.txt"
    : > "$xml_list_file"
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        printf '%s/%s\n' "$win_root" "$f" >> "$xml_list_file"
    done <<EOF
$staged_xml
EOF
    win_xml_list_file=$(printf '%s' "$xml_list_file" | sed -E 's#^/([a-zA-Z])/#\1:/#')

    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "C:/FS25/main/Source/Checks/xml/Invoke-XmlCheck.ps1" -Mod "$mod_name" -FileListPath "$win_xml_list_file"
    xml_status=$?

    rm -f "$xml_list_file"

    if [ $xml_status -ne 0 ]; then
        echo ""
        echo "pre-commit: XML-Check fehlgeschlagen (siehe Ausgabe oben). Commit abgebrochen."
        exit 1
    fi

    # Schritt 3 (Asset-Pfad-Check): loest jedes Pfad-Attribut/-Element in den
    # staged XML-Dateien gegen den Mod-Ordner auf und prueft Existenz +
    # exakte Gross-/Kleinschreibung (Windows ist case-insensitive, ein
    # dedizierter Linux-Server nicht). Immer blockierend, siehe
    # Invoke-AssetPathCheck.ps1.
    xml_list_file2="$repo_root/.git/pre-commit-xml-files.txt"
    : > "$xml_list_file2"
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        printf '%s/%s\n' "$win_root" "$f" >> "$xml_list_file2"
    done <<EOF
$staged_xml
EOF
    win_xml_list_file2=$(printf '%s' "$xml_list_file2" | sed -E 's#^/([a-zA-Z])/#\1:/#')

    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "C:/FS25/main/Source/Checks/assets/Invoke-AssetPathCheck.ps1" -Mod "$mod_name" -ModRoot "$win_root" -FileListPath "$win_xml_list_file2"
    asset_status=$?

    rm -f "$xml_list_file2"

    if [ $asset_status -ne 0 ]; then
        echo ""
        echo "pre-commit: Asset-Pfad-Check fehlgeschlagen (siehe Ausgabe oben). Commit abgebrochen."
        exit 1
    fi
fi

exit 0
